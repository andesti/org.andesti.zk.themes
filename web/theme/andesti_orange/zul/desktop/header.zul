<?xml version="1.0" encoding="UTF-8"?>
<zk>
<zscript>
    import org.compiere.model.MRefList;
    import org.compiere.model.MSysConfig;
    import org.compiere.model.MSystem;
    import org.compiere.util.Env;
    import org.compiere.util.Msg;
    import org.compiere.util.Util;
    var msgText = "";
    var msgValue = MSysConfig.getValue(MSysConfig.ZK_DESKTOP_HEADER_MESSAGE_VALUE);
	if (!Util.isEmpty(msgValue, true))
		msgText = Msg.getMsg(Env.getCtx(), msgValue);

	/* AndesTI: logo por tenant. Prioridad: Logo de la Organizacion (AD_OrgInfo),
	   Logo Web / Logo del Grupo Empresarial (AD_ClientInfo). Si no hay, queda el logo del tema. */
	byte[] andestiLogoData(int imageId) {
		if (!(imageId > 0))
			return null;
		org.compiere.model.MImage mi = org.compiere.model.MImage.get(Env.getCtx(), imageId);
		return mi != null ? mi.getData() : null;
	}
	void andestiSetClientLogo(img) {
		try {
			byte[] data = null;
			org.compiere.model.MOrgInfo oi = org.compiere.model.MOrgInfo.get(Env.getAD_Org_ID(Env.getCtx()));
			if (oi != null)
				data = andestiLogoData(oi.getLogo_ID());
			org.compiere.model.MClientInfo ci = org.compiere.model.MClientInfo.get(Env.getCtx());
			if (data == null &amp;&amp; ci != null)
				data = andestiLogoData(ci.getLogoWeb_ID());
			if (data == null &amp;&amp; ci != null)
				data = andestiLogoData(ci.getLogo_ID());
			if (data != null)
				img.setContent(new org.zkoss.image.AImage("logo", data));
		} catch (Throwable e) {
			// sin logo del tenant: se mantiene el del tema
		}
	}
</zscript>
<zscript><![CDATA[
	/* AndesTI: logo del login y favicon desde AD_ClientInfo del Grupo Empresarial System.
	   Login: Logo, si no Logo Web. Favicon: Logo Web, si no Logo. Si no hay imagen, quedan los del tema. */
	String andestiSystemLogoUri(boolean logoFirst) {
		try {
			org.compiere.model.MClientInfo ci = org.compiere.model.MClientInfo.get(0);
			if (ci == null)
				return null;
			int first = logoFirst ? ci.getLogo_ID() : ci.getLogoWeb_ID();
			int second = logoFirst ? ci.getLogoWeb_ID() : ci.getLogo_ID();
			int id = first > 0 ? first : second;
			if (!(id > 0))
				return null;
			org.compiere.model.MImage mi = org.compiere.model.MImage.get(id);
			byte[] d = mi != null ? mi.getData() : null;
			if (d == null || d.length < 4)
				return null;
			String mime = "image/png";
			int b0 = d[0] & 0xFF;
			if (b0 == 0xFF) mime = "image/jpeg";
			else if (b0 == 0x47) mime = "image/gif";
			else if (b0 == 0x3C) mime = "image/svg+xml";
			return "data:" + mime + ";base64," + java.util.Base64.getEncoder().encodeToString(d);
		} catch (Throwable e) {
			return null;
		}
	}
	String andestiLoginLogo = andestiSystemLogoUri(true);
	String andestiFavicon = andestiSystemLogoUri(false);
	if (andestiLoginLogo != null || andestiFavicon != null)
		org.zkoss.zk.ui.util.Clients.evalJavaScript(
			"(function(u,f){if(u){var s=document.getElementById('andesti-logo-css');"
			+ "if(!s){s=document.createElement('style');s.id='andesti-logo-css';document.head.appendChild(s);}"
			+ "s.textContent='.login-box-header-logo img{content:url(\"'+u+'\");width:auto!important;height:auto!important;max-width:260px!important;max-height:110px!important;object-fit:contain;}';}"
			+ "if(f){var l=document.querySelector('link[rel~=\"icon\"]');"
			+ "if(!l){l=document.createElement('link');l.rel='icon';document.head.appendChild(l);}"
			+ "l.href=f;}})('" + (andestiLoginLogo != null ? andestiLoginLogo : "") + "','"
			+ (andestiFavicon != null ? andestiFavicon : "") + "');");
]]></zscript>
	<div sclass="desktop-header" use="org.adempiere.webui.panel.HeaderPanel" id="header">
		<hbox vflex="1" hflex="1" align="center">
			<hbox  height="100%" pack="start" align="center" sclass="desktop-header-left" hflex="1">
					<image id="logo" sclass="desktop-header-logo"
						onCreate='org.zkoss.zk.ui.event.Events.echoEvent("onClientLogo", self, null)'
						onClientLogo="andestiSetClientLogo(self)"/>
					<div id="menuLookup"/>
					<button id="menuButton" sclass="btn-small"/>
					<span class="systemStatus">${msgText}</span>
			</hbox>
			<vbox  hflex="min" apply="org.adempiere.webui.panel.UserPanel" align="end"
					sclass="desktop-user-panel">
					<vbox  align="end">
						<label use="org.adempiere.webui.component.Label" id="loginUserAndRole" 
							style="cursor: pointer;"
							sclass="desktop-header-font desktop-header-username"/>
						<hbox align="center" id="userPanelLinksContainer" hflex="min">
							<toolbarbutton use="org.adempiere.webui.component.ToolBarButton"
								sclass="desktop-header-font link" id="feedback"/>
							<separator orient="vertical" bar="true" height="13px"/>
							<toolbarbutton use="org.adempiere.webui.component.ToolBarButton"
								sclass="desktop-header-font link" id="preference"/>
							<separator orient="vertical" bar="true" height="13px"/>
							<toolbarbutton use="org.adempiere.webui.component.ToolBarButton"
								sclass="desktop-header-font link" id="changeRole"/>
							<separator orient="vertical" bar="true" height="13px"/>
							<toolbarbutton use="org.adempiere.webui.component.ToolBarButton"
								sclass="desktop-header-font link" id="logout"/>
						</hbox>
					</vbox>
			</vbox>
		</hbox>
	</div>
</zk>
